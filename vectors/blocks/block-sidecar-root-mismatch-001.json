  "owned_by": "shell-consensus",
  "transactions_root": "0xaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
  "execution_witnesses_root": "0x5555555555555555555555555555555555555555555555555555555555555555",
  "state_root": "0xcccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
  "receipts_root": "0xdddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd",
  "notes": "This vector isolates sidecar commitment failure while holding the sidecar.block_root match fixed. A future consensus importer should fail it at the sidecar-binding stage, before any execution or post-state root comparison."
