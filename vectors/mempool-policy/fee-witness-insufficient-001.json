    "authorizations": [
      {
        "scheme_id": 0,
        "signature_hex": "0xabababababababababababababababababababababababababababababababababababababababababababababababababababababababababababababababab",
        "payload_root_mode": "canonical"
      }
    ],
    "authorization_materials": [
      {
        "public_key_hex": "0x7777777777777777777777777777777777777777777777777777777777777777"
      }
