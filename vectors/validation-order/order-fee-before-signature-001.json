{
  "id": "order-fee-before-signature-001",
  "category": "validation-order",
  "rule": "fee_before_signature",
  "description": "A payload-lane fee-floor failure is classified as a policy rejection before the transaction signature dispatcher runs.",
  "input": {
    "layer": "shell-mempool",
    "payload": {
      "nonce": 5,
      "gas_limit": 21000,
      "regular_fee": 5,
      "max_priority_fee_per_gas": 1,
      "max_witness_priority_fee": 7,
      "to": "0x1111111111111111111111111111111111111111"
    },
    "authorizations": [
      {
        "scheme_id": 0,
        "signature_hex": "0xabababababababababababababababababababababababababababababababababababababababababababababababababababababababababababababababab",
        "payload_root_mode": "canonical"
      }
    ],
    "authorization_materials": [
      {
        "public_key_hex": "0x7777777777777777777777777777777777777777777777777777777777777777"
      }
    ],
    "policy": {
      "payload_lane_base_fee": 9,
      "witness_lane_base_fee": 3,
      "max_future_nonce_gap": 1
    }
  },
  "expected_outcome": "policy_reject",
  "expected_error": {
    "kind": "FeeFloor",
    "lane": "payload"
  },
  "expected_effects": {
    "transaction_signature_verifications": 0
  },
  "owned_by": "shell-mempool",
  "notes": "The vector uses the same shared contract as consensus ordering fixtures, but records the mempool-specific distinction between malformed-object rejection and soft local policy rejection."
}
