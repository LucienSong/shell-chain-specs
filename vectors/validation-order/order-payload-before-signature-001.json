{
  "id": "order-payload-before-signature-001",
  "category": "validation-order",
  "rule": "payload_before_signature",
  "description": "A payload_root mismatch is rejected in T1 without calling the transaction signature dispatcher.",
  "input": {
    "layer": "shell-mempool",
    "payload": {
      "nonce": 5,
      "gas_limit": 21000,
      "regular_fee": 5,
      "max_priority_fee_per_gas": 1,
      "max_witness_priority_fee": 7,
      "to": "0x1111111111111111111111111111111111111111"
    },
    "authorizations": [
      {
        "scheme_id": 0,
        "signature_hex": "0xabababababababababababababababababababababababababababababababababababababababababababababababababababababababababababababababab",
        "payload_root_mode": "flip_first_byte"
      }
    ],
    "authorization_materials": [
      {
        "public_key_hex": "0x7777777777777777777777777777777777777777777777777777777777777777"
      }
    ],
    "policy": {
      "payload_lane_base_fee": 2,
      "witness_lane_base_fee": 3,
      "max_future_nonce_gap": 1
    }
  },
  "expected_outcome": "reject",
  "expected_error": {
    "kind": "PayloadRootMismatch"
  },
  "expected_effects": {
    "transaction_signature_verifications": 0
  },
  "owned_by": "shell-mempool",
  "notes": "This shared ordering vector freezes the local rule that payload binding must fail closed before any expensive transaction-path cryptography runs."
}
